            "id": "projects/inhausbrain/datasets/marketing_mart/tables/v_cross_platform_summary",
            "labels": {
              "component": "marketing-intelligence",
              "environment": "production",
              "managed_by": "terraform"
            },
            "last_modified_time": 1772086030385,
            "location": "US",
            "materialized_view": [],
            "max_staleness": "",
            "num_bytes": 0,
            "num_long_term_bytes": 0,
            "num_rows": 0,
            "project": "inhausbrain",
            "range_partitioning": [],
            "require_partition_filter": false,
            "resource_tags": null,
            "schema": "[{\"mode\":\"NULLABLE\",\"name\":\"client_id\",\"type\":\"STRING\"},{\"mode\":\"NULLABLE\",\"name\":\"platform\",\"type\":\"STRING\"},{\"mode\":\"NULLABLE\",\"name\":\"report_date\",\"type\":\"DATE\"},{\"mode\":\"NULLABLE\",\"name\":\"campaign_id\",\"type\":\"STRING\"},{\"mode\":\"NULLABLE\",\"name\":\"campaign_name\",\"type\":\"STRING\"},{\"mode\":\"NULLABLE\",\"name\":\"objective\",\"type\":\"STRING\"},{\"mode\":\"NULLABLE\",\"name\":\"campaign_status\",\"type\":\"STRING\"},{\"mode\":\"NULLABLE\",\"name\":\"total_impressions\",\"type\":\"INTEGER\"},{\"mode\":\"NULLABLE\",\"name\":\"total_clicks\",\"type\":\"INTEGER\"},{\"mode\":\"NULLABLE\",\"name\":\"total_spend\",\"type\":\"FLOAT\"},{\"mode\":\"NULLABLE\",\"name\":\"total_conversions\",\"type\":\"INTEGER\"},{\"mode\":\"NULLABLE\",\"name\":\"total_conversion_value\",\"type\":\"FLOAT\"},{\"mode\":\"NULLABLE\",\"name\":\"total_reach\",\"type\":\"INTEGER\"},{\"mode\":\"NULLABLE\",\"name\":\"avg_ctr\",\"type\":\"FLOAT\"},{\"mode\":\"NULLABLE\",\"name\":\"avg_cpc\",\"type\":\"FLOAT\"},{\"mode\":\"NULLABLE\",\"name\":\"avg_cpm\",\"type\":\"FLOAT\"},{\"mode\":\"NULLABLE\",\"name\":\"roas\",\"type\":\"FLOAT\"},{\"mode\":\"NULLABLE\",\"name\":\"currency\",\"type\":\"STRING\"}]",
            "self_link": "https://bigquery.googleapis.com/bigquery/v2/projects/inhausbrain/datasets/marketing_mart/tables/v_cross_platform_summary",
            "table_constraints": [],
            "table_id": "v_cross_platform_summary",
            "table_replication_info": [],
            "terraform_labels": {
              "component": "marketing-intelligence",
              "environment": "production",
              "managed_by": "terraform"
            },
            "time_partitioning": [],
            "type": "VIEW",
            "view": [
              {
                "query": "SELECT\n  f.client_id,\n  f.platform,\n  f.report_date,\n  f.campaign_id,\n  c.campaign_name,\n  c.objective,\n  c.status          AS campaign_status,\n  SUM(f.impressions)       AS total_impressions,\n  SUM(f.clicks)            AS total_clicks,\n  SUM(f.spend)             AS total_spend,\n  SUM(f.conversions)       AS total_conversions,\n  SUM(f.conversion_value)  AS total_conversion_value,\n  SUM(f.reach)             AS total_reach,\n  SAFE_DIVIDE(SUM(f.clicks),       NULLIF(SUM(f.impressions), 0)) AS avg_ctr,\n  SAFE_DIVIDE(SUM(f.spend),        NULLIF(SUM(f.clicks), 0))      AS avg_cpc,\n  SAFE_DIVIDE(SUM(f.spend) * 1000, NULLIF(SUM(f.impressions), 0)) AS avg_cpm,\n  SAFE_DIVIDE(SUM(f.conversion_value), NULLIF(SUM(f.spend), 0))   AS roas,\n  f.currency\nFROM `inhausbrain.marketing_mart.fact_daily_ad_performance` AS f\nLEFT JOIN `inhausbrain.marketing_mart.dim_campaign` AS c\n  ON  f.campaign_id = c.campaign_id\n  AND f.platform    = c.platform\n  AND f.client_id   = c.client_id\nGROUP BY\n  f.client_id, f.platform, f.report_date,\n  f.campaign_id, c.campaign_name, c.objective,\n  c.status, f.currency\n",
                "use_legacy_sql": false
              }
            ]
          },
          "sensitive_attributes": [],
          "private": "bnVsbA==",
          "dependencies": [
            "google_bigquery_dataset.marketing_mart"
          ]
        }
      ]
