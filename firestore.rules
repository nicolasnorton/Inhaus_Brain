rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is owner of the document (assuming userId field)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role helpers (assuming role in token or user document)
    function getRole() {
      return request.auth.token.get('role', '');
    }

    function hasRole(role) {
      return isAuthenticated() && getRole() == role;
    }

    function isSuperAdmin() {
      return hasRole('superAdmin');
    }

    function isAgencyStaff() {
      return isAuthenticated() && (
        getRole() == 'superAdmin' || 
        getRole() == 'admin' || 
        getRole() == 'humanAgencyStaff' ||
        getRole() == 'accountManager' ||
        request.auth.token.email == 'nnorton@inhausbrain.com'
      );
    }

    function isClient() {
      return hasRole('clientUser');
    }

    // REPORTS MODULE RULES
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAgencyStaff() || (isClient() && resource.data.get('clientId', '') == request.auth.uid);
      allow update, delete: if isAgencyStaff();
    }

    match /dashboards/{dashboardId} {
      allow create: if isAgencyStaff();
      allow read: if isAgencyStaff() || (isClient() && resource.data.get('clientId', '') == request.auth.uid);
      allow update, delete: if isAgencyStaff();
    }

    match /connected_accounts/{accountId} {
      allow create: if isAgencyStaff();
      allow read: if isAgencyStaff() || (isClient() && resource.data.get('clientId', '') == request.auth.uid);
      allow update, delete: if isAgencyStaff();
    }

    match /campaigns/{campaignId} {
      allow create: if isAuthenticated();
      allow read: if isAgencyStaff() || (isClient() && resource.data.get('clientId', '') == request.auth.uid);
      allow update, delete: if isAgencyStaff();
    }

    // PROPOSALS MODULE RULES
    match /proposals/{proposalId} {
      allow create: if isAuthenticated();
      allow read: if isAgencyStaff() || (isClient() && resource.data.get('clientId', '') == request.auth.uid);
      allow update, delete: if isAgencyStaff();
    }

    // SERVICES MODULE RULES
    match /services/{serviceId} {
      // All authenticated users can read services (for proposal creation)
      allow read: if isAuthenticated();
      // Only agency staff can create, update, or delete services
      allow create, update, delete: if isAgencyStaff();
    }

    // KNOWLEDGE MODULE RULES (Production Hardened)
    match /knowledge_datasets/{datasetId} {
      // Allow creation by any authenticated user (Agency OR Client wanting private knowledge)
      allow create: if isAuthenticated();
      
      allow read: if isAgencyStaff() || (
        isClient() && (
          resource.data.get('permission', '') == 'client_shared' ||
          resource.data.get('clientId', '') == request.auth.uid
        )
      ) || resource.data.createdBy == request.auth.uid; // Allow creator to read
      
      allow update, delete: if isAgencyStaff() || resource.data.createdBy == request.auth.uid;
      
      match /documents/{documentId} {
        allow create: if isAuthenticated(); // Allow adding docs
        allow read: if isAgencyStaff() || isClient() || get(/databases/$(database)/documents/knowledge_datasets/$(datasetId)).data.createdBy == request.auth.uid;
        allow update, delete: if isAgencyStaff() || get(/databases/$(database)/documents/knowledge_datasets/$(datasetId)).data.createdBy == request.auth.uid;
        
        match /chunks/{chunkId} {
          allow create: if isAuthenticated(); 
          allow read: if isAgencyStaff() || isClient() || get(/databases/$(database)/documents/knowledge_datasets/$(datasetId)).data.createdBy == request.auth.uid;
          allow update, delete: if isAgencyStaff() || get(/databases/$(database)/documents/knowledge_datasets/$(datasetId)).data.createdBy == request.auth.uid;
        }
      }
    }

    // AGENCY SERVICES CATALOG RULES
    match /knowledge/{knowledgeDoc} {
      // Allow read access to agency_services for all authenticated users
      allow read: if isAuthenticated();
      // Only agency staff can write to the catalog
      allow write: if isAgencyStaff();
      
      match /data/{dataDoc} {
        allow read: if isAuthenticated();
        // Only agency staff can write to the catalog data
        allow write: if isAgencyStaff();
      }
    }
    
    // COTIZADOR (PROPOSALS LM) RULES
    match /cotizadorQuotes/{quoteId} {
      allow read, write: if isAgencyStaff();
    }
    match /cotizadorPackages/{packageId} {
      allow read, write: if isAgencyStaff();
    }
    match /proformaStyles/{styleId} {
      allow read, write: if isAgencyStaff();
    }
    
    // CLIENTS MODULE RULES
    match /clients/{clientId} {
      allow read, write: if isAuthenticated(); 
    }

    // USER PROFILES & USER KNOWLEDGE
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId);

      // User-specific Knowledge (Reference from summary)
      match /knowledge/{docId} {
         allow read, write: if isOwner(userId);
      }

      // Semantic Cache (Fix for permission-denied)
      match /cache/{docId} {
         allow read, write: if isOwner(userId);
      }

      // Analytics Events
      match /events/{docId} {
         allow read, write: if isOwner(userId);
      }

      // Blackboard Sessions
      match /sessions/{docId} {
         allow read, write: if isOwner(userId);
      }
    }

    // AUDIT LOGS (Written by AuditLogService — tamper-evident, append-only)
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAgencyStaff();
      allow update, delete: if false;
    }

    // GLOBAL ANALYTICS EVENTS (Written by AnalyticsService — BigQuery target)
    match /global_events/{eventId} {
      allow create: if isAuthenticated();
      allow read: if isAgencyStaff();
      allow update, delete: if false;
    }

    // AGENT TASKS (Written by enqueue_agent_task Python function)
    match /agent_tasks/{taskId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if isAgencyStaff();
    }

    // WORKSPACE (Agentic Architecture — User-Owned Agent State)
    match /workspaces/{userId} {
      allow read, write: if isOwner(userId);

      // Workspace docs: identity, soul, user_profile, agent_rules, memory, heartbeat
      match /docs/{docType} {
        allow read, write: if isOwner(userId);
      }

      // Daily activity notes (YYYYMMDD keys)
      match /daily_notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      // Agent registry (metadata + full prompts)
      match /agent_registry/{agentName} {
        allow read, write: if isOwner(userId);
      }

      // Runtime skills
      match /skills/{skillName} {
        allow read, write: if isOwner(userId);
      }
    }

    // A2UI Composer & Library
    match /a2ui_widgets/{widgetId} {
      allow read, write: if isAuthenticated();
    }

    // ── BRAINWEAVE MODULE RULES ─────────────────────────────────────────────
    // Strict service isolation: only the owner can read/write their own data.
    // Agency staff has read access for oversight and support.

    match /brainweave_cores/{coreId} {
      allow create: if isAuthenticated() && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow read: if isAgencyStaff() || (isAuthenticated() && resource.data.get('ownerId', '') == request.auth.uid);
      allow update, delete: if isAuthenticated() && resource.data.get('ownerId', '') == request.auth.uid;
    }

    match /brainweave_nodes/{nodeId} {
      allow create: if isAuthenticated() && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow read: if isAgencyStaff() || (isAuthenticated() && resource.data.get('ownerId', '') == request.auth.uid);
      allow update, delete: if isAuthenticated() && resource.data.get('ownerId', '') == request.auth.uid;
    }

    match /brainweave_links/{linkId} {
      allow create: if isAuthenticated() && request.resource.data.get('ownerId', '') == request.auth.uid;
      allow read: if isAgencyStaff() || (isAuthenticated() && resource.data.get('ownerId', '') == request.auth.uid);
      allow update, delete: if isAuthenticated() && resource.data.get('ownerId', '') == request.auth.uid;
    }

    match /brainweave_sessions/{sessionId} {
      allow create: if isAuthenticated();
      allow read: if isAgencyStaff() || (isAuthenticated() && resource.data.get('clientId', '') == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.get('clientId', '') == request.auth.uid;
      allow delete: if isAgencyStaff();
    }

    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
