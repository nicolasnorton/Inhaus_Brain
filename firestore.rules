rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is owner of the document (assuming userId field)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role helpers (assuming role in token or user document)
    function getRole() {
      return request.auth.token.get('role', '');
    }

    function hasRole(role) {
      return isAuthenticated() && getRole() == role;
    }

    function isSuperAdmin() {
      return hasRole('superAdmin');
    }

    function isAgencyStaff() {
      return isAuthenticated() && (
        getRole() == 'superAdmin' || 
        getRole() == 'admin' || 
        getRole() == 'humanAgencyStaff' ||
        getRole() == 'accountManager'
      );
    }

    function isClient() {
      return hasRole('clientUser');
    }

    // REPORTS MODULE RULES
    match /reports/{reportId} {
      allow create: if isAgencyStaff();
      allow read: if isAgencyStaff() || (isClient() && resource.data.get('clientId', '') == request.auth.uid);
      allow update, delete: if isAgencyStaff();
    }

    match /dashboards/{dashboardId} {
      allow create: if isAgencyStaff();
      allow read: if isAgencyStaff() || (isClient() && resource.data.get('clientId', '') == request.auth.uid);
      allow update, delete: if isAgencyStaff();
    }

    match /connected_accounts/{accountId} {
      allow create: if isAgencyStaff();
      allow read: if isAgencyStaff() || (isClient() && resource.data.get('clientId', '') == request.auth.uid);
      allow update, delete: if isAgencyStaff();
    }

    match /campaigns/{campaignId} {
      allow create: if isAgencyStaff();
      allow read: if isAgencyStaff() || (isClient() && resource.data.get('clientId', '') == request.auth.uid);
      allow update, delete: if isAgencyStaff();
    }

    // KNOWLEDGE MODULE RULES (Production Hardened)
    match /knowledge_datasets/{datasetId} {
      allow create: if isAgencyStaff();
      
      allow read: if isAgencyStaff() || (
        isClient() && (
          resource.data.get('permission', '') == 'client_shared' ||
          resource.data.get('clientId', '') == request.auth.uid
        )
      );
      
      allow update, delete: if isAgencyStaff() && (
        isSuperAdmin() || resource.data.get('createdBy', '') == request.auth.uid
      );
      
      match /documents/{documentId} {
        allow read: if isAgencyStaff() || isClient();
        allow write: if isAgencyStaff();
        
        match /chunks/{chunkId} {
          allow read: if isAgencyStaff() || isClient();
          allow write: if isAgencyStaff();
        }
      }
    }
    
    // USER PROFILES
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
