# Inhaus Brain Environment Variables Example
# Copy this to .env and fill in your keys

# AI Services
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
VEO_API_KEY=your_veo_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
STITCH_API_KEY=your_stitch_key_here

# Firebase Configuration (if not using google-services.json)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=inhaus-brain
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Security
APP_ENCRYPTION_KEY=some_long_random_string_for_secure_storage
